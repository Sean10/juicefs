# /etc/default/vector (deb) or /etc/sysconfig/vector (rpm), read by the packaged vector.service
KAFKA_BOOTSTRAP=172.30.0.2:9092
KAFKA_TOPIC=juicefs-accesslog
# Time zone of the juicefs mount process: access log timestamps are rendered in local time.
JUICEFS_TZ=Asia/Shanghai
JFS_CLUSTER=prod-baremetal
# Only read these mount points (space separated prefixes); empty = every JuiceFS mount.
MOUNT_PREFIXES=/jfs
JFS_KEEP_RAW=false
